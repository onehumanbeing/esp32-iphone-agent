<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>ESP32 Agent</string>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>ESP32 Agent runs</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.zip-archive</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>ESP32 Agent intent</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.onehumanbeing.esp32agent.intent</string>
			</array>
		</dict>
	</array>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>zh-Hans</string>
	</array>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(IA_BUNDLE_ID)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>iphoneagent</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>IAAppGroup</key>
	<string>group.$(IA_BUNDLE_ID)</string>
	<key>IAPostHogHost</key>
	<string>$(IA_POSTHOG_HOST)</string>
	<key>IAPostHogKey</key>
	<string>$(IA_POSTHOG_KEY)</string>
	<key>IAPresetBaseURL</key>
	<string>$(IA_PRESET_BASE_URL)</string>
	<key>IAPresetKey</key>
	<string>$(IA_PRESET_KEY)</string>
	<key>IAPresetModel</key>
	<string>$(IA_PRESET_MODEL)</string>
	<key>IAStoreBuild</key>
	<string>$(IA_STORE_BUILD)</string>
	<key>IATrialOrigin</key>
	<string>$(IA_TRIAL_ORIGIN)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>ESP32 Agent talks to its board over Bluetooth to see the screen and move the pointer.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_esp32agent._tcp</string>
		<string>_handsy-harness._tcp</string>
	</array>
	<key>NSLocalNetworkUsageDescription</key>
	<string>ESP32 Agent receives the screen from its board over the board's Wi-Fi, and connects to a model server you configure on your local network.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>With Listen to phone audio on, ESP32 Agent turns the sound your iPhone plays while mirroring into text, on this iPhone, so the agent can follow videos and calls.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>bluetooth-central</string>
	</array>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<key>UIImageName</key>
		<string>LaunchLogo</string>
	</dict>
	<key>UIRequiresFullScreen</key>
	<true/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.json</string>
				<string>public.data</string>
			</array>
			<key>UTTypeDescription</key>
			<string>ESP32 Agent intent</string>
			<key>UTTypeIdentifier</key>
			<string>com.onehumanbeing.esp32agent.intent</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>esp32intent</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/vnd.esp32agent.intent+json</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
