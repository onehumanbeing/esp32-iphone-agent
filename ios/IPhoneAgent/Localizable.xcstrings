        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "事实"
          }
        }
      }
    },
    "Nothing yet. Tell the agent \"remember …\" in a task, or add a line here. Lessons from finished runs show up here too." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "还没有。在任务里对 agent 说“记住……”，或在这里添加一条。完成的任务学到的经验也会显示在这里。"
          }
        }
      }
    },
    "Passwords, codes and card numbers are never kept." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "密码、验证码和卡号永远不会保存。"
          }
        }
      }
    },
    "Preference" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "偏好"
          }
        }
      }
    },
    "e.g. I prefer short answers" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "例如：我喜欢简短的回答"
