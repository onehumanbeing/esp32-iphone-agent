    "Copy the notebook" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "复制笔记本"
          }
        }
      }
    },
    "Let AI do it" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "交给 AI"
          }
        }
      }
    },
    "Moves run without the AI while the screen matches; swipe a step to let the AI do it instead. With Repeat until, the steps run again until the condition is true on screen." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "屏幕一致时，动作直接执行、不走 AI；左滑某一步可以改成交给 AI。设置“重复直到”后，这些步骤会反复执行，直到屏幕上满足条件。"
          }
        }
      }
    },
    "Read from the screen" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从屏幕读取"
          }
        }
      }
    },
    "Repeat until" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重复直到"
          }
        }
      }
    },
    "You: %@" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你：%@"
          }
        }
      }
    },
    "e.g. Log in" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "例如：登录"
          }
        }
