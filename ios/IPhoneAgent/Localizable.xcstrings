    },
    "%@ Press and hold for Continue, Skip or Stop." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 长按通知可选择继续、跳过或停止。"
