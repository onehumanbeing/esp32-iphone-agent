{
  "sourceLanguage" : "en",
  "version" : "1.0",
  "strings" : {
    "NSScreenCaptureUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share this iPhone screen so the agent can see and operate it during tasks."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共享此 iPhone 的屏幕，让智能体在执行任务时查看并操作屏幕。"
          }
        }
      }
    },
    "CFBundleDisplayName" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ESP32 Agent"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ESP32 Agent"
          }
        }
      }
    },
    "NSBluetoothAlwaysUsageDescription" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ESP32 Agent talks to its USB board over Bluetooth to see the screen and move the pointer."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ESP32 Agent 通过蓝牙与 USB 开发板通信，用来查看屏幕和移动指针。"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ESP32 Agent receives the screen from its board over the board's Wi-Fi, and connects to a model server you configure on your local network."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ESP32 Agent 通过板子的 Wi-Fi 接收屏幕画面，并连接你在局域网中配置的模型服务器。"
          }
        }
      }
    }
  }
}
