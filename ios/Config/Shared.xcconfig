// Signing: put your team in Config/Local.xcconfig (gitignored), e.g.
//   DEVELOPMENT_TEAM = ABCDE12345

// Bundle ID of the app; the widget extension and tests append a suffix, the App Group is group.<this>.
// Set your own in Local.xcconfig.
IA_BUNDLE_ID = com.example.esp32agent

// Once Xcode is signed in, set IA_ENTITLEMENTS = IPhoneAgent/IPhoneAgent.entitlements in Local.xcconfig
// to enable one-tap joining of the board's hotspot, and IA_WIDGET_ENTITLEMENTS =
// AgentActivity/AgentActivity.entitlements so the widgets share the App Group.
IA_ENTITLEMENTS =
IA_WIDGET_ENTITLEMENTS =

// Optional LLM preset for your own builds, set in Local.xcconfig (write "//" as "/$()/").
// Never in a store build: fastlane's beta lane clears these and checks the built app.
//   IA_PRESET_BASE_URL = https:/$()/example.com/v1
IA_PRESET_BASE_URL =
IA_PRESET_MODEL =
IA_PRESET_KEY =

// Opt-in anonymous usage stats (a PostHog project API key, public by design). Empty = no switch and
// nothing is sent: every local build, unless you set your own key (and host) in Local.xcconfig.
// Store builds get the official key from fastlane (IA_POSTHOG_KEY in ~/.appstoreconnect/config.env).
IA_POSTHOG_KEY =
IA_POSTHOG_HOST = https:/$()/us.i.posthog.com
// YES only in fastlane store builds: the AI-service consent sheet before any model request (AIConsent).
IA_STORE_BUILD = NO

// The free line's server (Trial/), set by the store build; App Attest is production only there.
IA_TRIAL_ORIGIN =
IA_APP_ATTEST_ENV = development

// The name on the Home Screen and in texts about the app (AppName); a store build may set its own (fastlane).
IA_APP_NAME = ESP32 Agent

// The app and its widget extension share these; fastlane sets the build number for each upload.
MARKETING_VERSION = 1.0.6
CURRENT_PROJECT_VERSION = 1

#include? "Local.xcconfig"
