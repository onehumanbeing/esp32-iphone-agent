# Store builds: `fastlane beta` (from ios/) archives a Release and uploads it to TestFlight;
# `fastlane package` makes the same build in build/store without uploading.
# Auth is an App Store Connect API key described in ~/.appstoreconnect/config.env
# (ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_PATH); signing uses Xcode's Apple ID and the team in Config/Local.xcconfig.
# The LLM preset from Local.xcconfig is cleared and the built app is checked for it. The official PostHog key
# (IA_POSTHOG_KEY in config.env) is set only here, so local builds never report usage stats.

default_platform(:ios)

STORE_ENV = File.expand_path("~/.appstoreconnect/config.env")

def key_path
  File.expand_path(ENV["ASC_KEY_PATH"].gsub("$HOME", Dir.home))
end

platform :ios do
  private_lane :asc_key do
    File.readlines(STORE_ENV).each do |line|
      k, v = line.strip.split("=", 2)
      ENV[k] = v.delete('"') if k && v && !k.start_with?("#")
    end
    app_store_connect_api_key(key_id: ENV["ASC_KEY_ID"], issuer_id: ENV["ASC_ISSUER_ID"],
                              key_filepath: key_path)
  end

  desc "Release build to TestFlight (internal testers get it once processing finishes)"
  lane :beta do |options|
    ipa = package(options)
    upload_to_testflight(ipa: ipa, skip_waiting_for_build_processing: true,
                         skip_submission: true, distribute_external: false)
    UI.success("Uploaded build #{lane_context[SharedValues::BUILD_NUMBER]}")
  end

  desc "Upload an already packaged and checked IPA to TestFlight (no submission, no external testers)"
  lane :upload do |options|
    asc_key
    upload_to_testflight(ipa: options[:ipa], skip_waiting_for_build_processing: true,
                         skip_submission: true, distribute_external: false)
  end

  desc "The same store build as beta, kept in build/store without uploading"
  lane :package do |options|
    asc_key
    bundle_id = CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)
    UI.important("IA_POSTHOG_KEY is not in #{STORE_ENV}: this build sends no usage stats") if ENV["IA_POSTHOG_KEY"].to_s.empty?
    UI.important("IA_TRIAL_ORIGIN is not in #{STORE_ENV}: this build has no free line") if ENV["IA_TRIAL_ORIGIN"].to_s.empty?
    latest = latest_testflight_build_number(app_identifier: bundle_id, initial_build_number: 0)
    build = (options[:build] || latest + 1).to_i
    UI.user_error!("Build #{build} is not above the latest TestFlight build #{latest}") unless build > latest
    # Signing uses the Apple ID signed in to Xcode: only it can register the App Group (the API key can't).
    auth = "-allowProvisioningUpdates"
    settings = {
      IA_BUNDLE_ID: bundle_id,
      IA_ENTITLEMENTS: "IPhoneAgent/IPhoneAgent.entitlements",
      IA_WIDGET_ENTITLEMENTS: "AgentActivity/AgentActivity.entitlements",
      IA_PRESET_BASE_URL: "", IA_PRESET_MODEL: "", IA_PRESET_KEY: "",
      IA_POSTHOG_KEY: ENV["IA_POSTHOG_KEY"].to_s,
      IA_STORE_BUILD: "YES",
      IA_TRIAL_ORIGIN: ENV["IA_TRIAL_ORIGIN"].to_s, IA_APP_ATTEST_ENV: "production",  # free line
      CURRENT_PROJECT_VERSION: build,
    }
    # TestFlight-only builds read the TestFlight firmware list (Firmware.swift); store builds keep the default.
    settings[:SWIFT_ACTIVE_COMPILATION_CONDITIONS] = "$(inherited) TESTFLIGHT" if options[:testflight]
    settings = settings.map { |k, v| "#{k}='#{v}'" }.join(" ")

    ipa = build_app(project: "IPhoneAgent.xcodeproj", scheme: "IPhoneAgent", configuration: "Release",
                    export_method: "app-store", output_directory: "build/store", clean: true,
                    xcargs: "#{settings} #{auth}", export_xcargs: auth)
    check_no_preset(ipa: ipa)
    # Keep each build's symbols: crash_report events carry raw addresses, symbolicated with these.
    dsyms = File.expand_path("~/Library/Developer/ESP32Agent-dSYMs")
    FileUtils.mkdir_p(dsyms)
    FileUtils.cp(lane_context[SharedValues::DSYM_OUTPUT_PATH], "#{dsyms}/#{bundle_id}-#{build}.dSYM.zip")
    lane_context[SharedValues::BUILD_NUMBER] = build
    UI.success("Packaged #{bundle_id} build #{build}: #{ipa}")
    ipa
  end

  # Stop the upload if any LLM preset made it into the app: the Info.plist keys must be empty, and the
  # key from Local.xcconfig must appear in no file of the app (it is never printed).
  private_lane :check_no_preset do |options|
    local = File.expand_path("../Config/Local.xcconfig", __dir__)
    key = File.exist?(local) ? File.read(local)[/^\s*IA_PRESET_KEY\s*=\s*(\S+)/, 1] : nil
    Dir.mktmpdir do |dir|
      sh("unzip", "-q", options[:ipa], "-d", dir, log: false)
      plist = Dir["#{dir}/Payload/*.app/Info.plist"].first
      %w[IAPresetKey IAPresetBaseURL IAPresetModel].each do |name|
        value = `/usr/libexec/PlistBuddy -c "Print :#{name}" "#{plist}" 2>/dev/null`.strip
        UI.user_error!("#{name} is set in the store build; refusing to upload") unless value.empty?
      end
      if key && system("grep", "-rqF", "--", key, dir)
        UI.user_error!("The preset API key is inside the store build; refusing to upload")
      end
    end
    UI.success("No LLM preset in the store build")
  end
end
